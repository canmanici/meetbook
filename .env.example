# Copy to .env for local development. NEVER commit real secrets.

# Backend
DATABASE_URL=postgresql+asyncpg://meetbook:meetbook_dev@localhost:5432/meetbook
REDIS_URL=redis://:meetbook_dev@localhost:6379/0
JWT_SECRET=dev-only-change-me
ENV=local

# External services (leave empty locally; features degrade gracefully)
GOOGLE_PLACES_KEY=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
SMS_PROVIDER_KEY=

# Mobile (Expo reads EXPO_PUBLIC_* at build time)
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
