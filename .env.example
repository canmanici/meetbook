# Copy to .env for local development. NEVER commit real secrets.

# Backend
DATABASE_URL=postgresql+asyncpg://meetbook:meetbook_dev@localhost:5436/meetbook
REDIS_URL=redis://:meetbook_dev@localhost:6379/0
# Outside ENV=local/dev/test the app refuses to boot unless this is >= 32
# random characters. Generate one: openssl rand -hex 32
JWT_SECRET=dev-only-change-me
ENV=local
CORS_ORIGINS=http://localhost:8081

# External services (leave empty locally; features degrade gracefully)
GOOGLE_PLACES_KEY=
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
SMS_PROVIDER_KEY=
MEDIA_DIR=/app/media

# Mobile (Expo reads EXPO_PUBLIC_* at build time)
EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1

# --- Security switches (safe defaults; shown here so they're discoverable) ---
# Request rate limiting (global + per-route). Default true.
RATE_LIMIT_ENABLED=true
# Login brute-force lockout: 5 failures / 15 min per account+IP. Default true.
LOGIN_THROTTLE_ENABLED=true
# Book credits block requests only when true. Default false until the app
# build with wallet/verification screens ships.
CREDITS_ENFORCED=false
# SMTP is required outside local dev: without it new accounts cannot verify.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
