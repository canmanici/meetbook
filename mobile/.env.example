EXPO_PUBLIC_API_URL=http://localhost:8000/api/v1
# Get a free key at https://cloud.maptiler.com/account/keys/
EXPO_PUBLIC_MAPTILER_KEY=your_maptiler_key_here

# Sign in with Google — WEB OAuth client ID from Google Cloud Console
# (same value as backend GOOGLE_CLIENT_IDS). Empty = Google button hidden.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
