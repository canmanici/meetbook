{
  "expo": {
    "name": "MeetBook",
    "slug": "mobile",
    "version": "1.1.23",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.canmanici.meetbook"
    },
    "android": {
      "package": "com.canmanici.meetbook",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "MeetBook, g\u00f6r\u00fcnt\u00fcl\u00fc arama yapabilmen i\u00e7in kameran\u0131 kullan\u0131r.",
          "microphonePermission": "MeetBook, sesli ve g\u00f6r\u00fcnt\u00fcl\u00fc arama yapabilmen i\u00e7in mikrofonunu kullan\u0131r."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#11806B",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MeetBook, kitab\u0131n\u0131n konumunu i\u015faretlemen i\u00e7in konumunu kullan\u0131r.",
          "locationAlwaysAndWhenInUsePermission": "MeetBook, g\u00fcvenlik modu s\u0131ras\u0131nda arkada\u015flar\u0131nla konumunu payla\u015fmak i\u00e7in her zaman konumunu kullan\u0131r.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "MeetBook, kitab\u0131 teslim ve iade ederken durum foto\u011fraf\u0131 \u00e7ekmen i\u00e7in kameran\u0131 kullan\u0131r.",
          "photosPermission": "MeetBook, kitap foto\u011fraf\u0131 se\u00e7men i\u00e7in galerine eri\u015fir."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "permissions": [
              "CAMERA"
            ],
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
