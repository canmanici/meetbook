{
  "expo": {
    "name": "MeetBook",
    "slug": "mobile",
    "version": "1.1.55",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/images/icon.png",
      "bundleIdentifier": "com.canmanici.meetbook"
    },
    "android": {
      "package": "com.canmanici.meetbook",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-dev-client",
      "expo-router",
      [
        "@config-plugins/react-native-webrtc",
        {
          "cameraPermission": "MeetBook, görüntülü arama yapabilmen için kameranı kullanır.",
          "microphonePermission": "MeetBook, sesli ve görüntülü arama yapabilmen için mikrofonunu kullanır."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#11806B",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 76
          }
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-web-browser",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MeetBook, kitabının konumunu işaretlemen için konumunu kullanır.",
          "locationAlwaysAndWhenInUsePermission": "MeetBook, güvenlik modu sırasında arkadaşlarınla konumunu paylaşmak için her zaman konumunu kullanır.",
          "isIosBackgroundLocationEnabled": true,
          "isAndroidBackgroundLocationEnabled": true
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "MeetBook, kitabı teslim ve iade ederken durum fotoğrafı çekmen için kameranı kullanır.",
          "photosPermission": "MeetBook, kitap fotoğrafı seçmen için galerine erişir."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "@react-native-google-signin/google-signin"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
