# Variables for docker-compose.prod.yml's ${VAR} substitution.
# Paste these (with real values) into Dokploy's "Environment Variables" panel
# for this compose project — don't commit the filled-in version.

# Generate each secret with: openssl rand -hex 32
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Optional — leave empty to degrade gracefully
GOOGLE_PLACES_KEY=
SMS_PROVIDER_KEY=
