# Variables for docker-compose.prod.yml's ${VAR} substitution.
# Paste these (with real values) into Dokploy's "Environment Variables" panel
# for this compose project — don't commit the filled-in version.

# ── Required — generate each secret with: openssl rand -hex 32 ──────────────
POSTGRES_PASSWORD=
REDIS_PASSWORD=
JWT_SECRET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Shared with coturn (static-auth-secret). Empty = calls fall back to STUN
# only, so two phones behind CGNAT can't connect.
TURN_SECRET=

# ── Admin ──────────────────────────────────────────────────────────────────
# Bootstrap admin account. No password = not created. Re-synced every deploy.
SEED_ADMIN_EMAIL=admin@meetbook.app
SEED_ADMIN_PASSWORD=
# Your own registered account(s) that should be admin (comma-separated).
ADMIN_EMAILS=

# ── Optional — empty degrades gracefully ───────────────────────────────────
TURN_HOST=canmanici.com
# WEB OAuth client ID — empty hides "Sign in with Google" server-side.
GOOGLE_CLIENT_IDS=
GOOGLE_PLACES_KEY=
SMS_PROVIDER_KEY=
# Outgoing mail. Empty SMTP_HOST = no mail sent and email verification off.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=MeetBook <no-reply@canmanici.com>
# KVKK data-subject requests are forwarded here.
KVKK_CONTROLLER_EMAIL=
